{
  "compilerOptions": {
    "declaration": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "outDir": "src/generated-runtime",
    "rootDir": "src/generated",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/generated/**/*.ts"]
}
