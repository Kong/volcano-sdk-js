{
  "name": "@volcano.dev/sdk",
  "version": "1.10.2",
  "packageManager": "pnpm@10.34.1",
  "description": "Official JavaScript SDK for Volcano - Authentication, Database, Functions, Realtime, and more",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.mts",
        "default": "./dist/index.esm.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./realtime": {
      "import": {
        "types": "./dist/realtime.esm.d.mts",
        "default": "./dist/realtime.esm.mjs"
      },
      "require": {
        "types": "./dist/realtime.d.ts",
        "default": "./dist/realtime.js"
      }
    },
    "./durable": {
      "import": {
        "types": "./dist/durable.esm.d.mts",
        "default": "./dist/durable.esm.mjs"
      },
      "require": {
        "types": "./dist/durable.d.ts",
        "default": "./dist/durable.js"
      }
    },
    "./next/middleware": {
      "import": {
        "types": "./dist/next/middleware.esm.d.mts",
        "default": "./dist/next/middleware.esm.mjs"
      },
      "require": {
        "types": "./dist/next/middleware.d.ts",
        "default": "./dist/next/middleware.js"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs && node scripts/copy-types.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "pnpm generate:openapi && node scripts/check-openapi.mjs",
    "dev": "rollup -c -w",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0 && pnpm format:check",
    "lint:fix": "eslint . --fix && pnpm format",
    "test": "pnpm build && jest",
    "test:types": "tsc --noEmit -p tsconfig.json && tsc --ignoreConfig --noEmit --strictNullChecks --skipLibCheck false --moduleResolution bundler --module esnext --target es2022 src/index.d.ts src/durable.d.ts test/types/auth-contract.ts test/types/database-contract.ts test/types/durable-contract.ts test/types/openapi-contract.ts",
    "test:package": "publint --pack npm --strict",
    "test:watch": "pnpm build && jest --watch",
    "test:coverage": "pnpm build && jest --coverage",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --config jest.integration.config.cjs --testTimeout=120000",
    "test:contract": "jest --config jest.contract.config.cjs --runInBand",
    "prepublishOnly": "npm run build",
    "test:quickstart": "node scripts/check-package-quickstart.mjs",
    "audit": "node scripts/audit-dependencies.mjs",
    "quality": "pnpm run audit && pnpm lint && pnpm check:openapi && pnpm test:types && pnpm test:tooling && node scripts/prepare-test-reports.mjs && pnpm test --ci --json --outputFile=reports/unit.json && pnpm test:typed-runtime && pnpm test:contract --listTests && pnpm test:package && pnpm test:quickstart",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:typed-runtime": "jest --coverage --collectCoverageFrom=src/**/*.ts --collectCoverageFrom=!src/**/*.d.ts --runTestsByPath __tests__/next-request.test.ts __tests__/auth-session.test.ts __tests__/lock-clock.test.ts __tests__/database-connection-string.test.ts __tests__/lock-session.test.ts __tests__/token-claims.test.ts __tests__/function-url.test.ts __tests__/lock-validation.test.ts __tests__/realtime-identity.test.ts __tests__/auth-validation.test.ts"
  },
  "keywords": [
    "volcano",
    "kong",
    "auth",
    "authentication",
    "database",
    "postgresql",
    "serverless",
    "functions",
    "oauth",
    "rls",
    "row-level-security",
    "baas",
    "backend-as-a-service",
    "realtime",
    "websocket",
    "pubsub",
    "presence"
  ],
  "dependencies": {
    "centrifuge": "^5.7.4",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@aws/durable-execution-sdk-js": ">=2 <3"
  },
  "peerDependenciesMeta": {
    "@aws/durable-execution-sdk-js": {
      "optional": true
    }
  },
  "author": "Kong <office@konghq.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kong/volcano-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/Kong/volcano-sdk-js/issues"
  },
  "homepage": "https://github.com/Kong/volcano-sdk-js#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.3.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-jest": "^30.3.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-check": "4.10.2",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "jest-cucumber": "4.5.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "17.0.0",
    "openapi-typescript": "7.13.0",
    "orval": "8.26.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "rollup": "^4.60.1",
    "tslib": "2.8.1",
    "typescript": "^6.0.2"
  }
}
