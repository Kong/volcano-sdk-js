  "keywords": [
    "volcano",
    "durable",
    "serverless"
  ],
  "homepage": "https://volcano.dev/platform/functions/durable-functions",
  "license": "Apache-2.0",
  "author": "Kong <office@konghq.com>",
  "repository": {
