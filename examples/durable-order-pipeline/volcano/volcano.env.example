# Both functions read these. Deploy them with `volcano cloud variables deploy`
# before the first function deploy, so the handlers have them on their first run.
VOLCANO_API_URL=https://api.volcano.dev
VOLCANO_ANON_KEY=your-anon-key
VOLCANO_DATABASE=app

# A service key for the project. The pipeline runs with it (a durable execution
# has no signed-in user), and orders-api starts executions with it.
VOLCANO_SERVICE_KEY=your-service-key

# The durable function's id, printed by `volcano cloud durable deploy` and shown
# by `volcano cloud durable list`. orders-api starts executions against it.
DURABLE_FUNCTION_ID=00000000-0000-0000-0000-000000000000
