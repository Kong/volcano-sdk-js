{
  "$schema": "https://unpkg.com/knip@5.80.0/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts!",
        "src/realtime.ts!",
        "src/durable.ts!",
        "src/next/middleware.ts!",
        "__tests__/**/*.test.{js,ts}",
        "__tests__/browser-environment.cjs",
        "__tests__/node-environment.cjs",
        "scripts/*.test.mts",
        "test/types/**/*.ts",
        "examples/durable-order-pipeline/volcano/functions/*/index.js",
        "scripts/prepare-test-reports.mts",
        "scripts/check-openapi.mts",
        "scripts/run-mutation.mts",
        "scripts/verify-mutation-shards.mts",
        "scripts/clean-openapi.mts",
        "scripts/audit-dependencies.mts",
        "scripts/copy-types.mts",
        "scripts/jest-completeness.cts",
        "scripts/check-mutation-report.mts",
        "scripts/node-environment.cts",
        "scripts/browser-environment.cts",
        "scripts/node-completeness.mts"
      ],
      "project": [
        "src/**/*.{js,ts}!",
        "!src/generated/model/**",
        "!src/generated/client.ts",
        "!src/generated-runtime/**",
        "__tests__/**/*.{js,ts,cjs}",
        "scripts/**/*.{mts,cts}",
        "test/types/**/*.ts",
        "examples/durable-order-pipeline/volcano/functions/**/*.js",
        "test/fixtures/**/*.d.ts"
      ]
    },
    "examples/nextjs-notes-app": {
      "project": ["src/**/*.{js,css}!", "*.config.js"],
      "paths": {
        "@/*": ["./src/*"]
      }
    }
  }
}
